# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY="AIzaSyDa6fWNx6AXgfI03auWsynQW6svrAIWa0E"

# Firebase & Google Authentication:
# These values default to firebase-applet-config.json, or can be overridden in custom deployments:
VITE_FIREBASE_API_KEY="AIzaSyBOR7V1d-Y4aqJ-aW2yeYPAT9D5T-TBC_Q"
VITE_FIREBASE_AUTH_DOMAIN="zany-rigging-77dgj.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="zany-rigging-77dgj"
VITE_FIREBASE_STORAGE_BUCKET="zany-rigging-77dgj.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="915647157722"
VITE_FIREBASE_APP_ID="1:915647157722:web:fb9d2bff86f65cd1391ce3"
VITE_GOOGLE_CLIENT_ID="915647157722-v3dh50kmr92d8odurin9dvpep8d8mkh9.apps.googleusercontent.com"

# SMTP / Real Email OTP Dispatch Configuration (Gmail SMTP):
# To send real verification emails via Gmail, create a 16-character App Password:
# 1. Enable 2-Step Verification in Google Account (https://myaccount.google.com/security)
# 2. Go to App Passwords (https://myaccount.google.com/apppasswords)
# 3. Create a new App Password named "AuraHabit"
# 4. Fill in SMTP_USER (your Gmail) and SMTP_PASS (the 16-character password without spaces)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="\"AuraHabit Security\" <your-email@gmail.com>"
